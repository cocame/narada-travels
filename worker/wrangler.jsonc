{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "narada-form",
  "main": "form-worker.js",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  // Заявки: не больше 5 с одного IP в минуту. Origin-проверка отсекает только
  // браузеры — заголовок легко подделать из скрипта, лимит нужен именно от спама.
  "ratelimits": [
    {
      "name": "FORM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
